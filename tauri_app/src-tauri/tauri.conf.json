{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EEG-MDD-Tauri-Preview",
  "version": "1.0.0",
  "identifier": "cn.edu.eeg.mdd-tauri-preview",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EEG MDD Risk Preview",
        "width": 1560,
        "height": 940,
        "minWidth": 1320,
        "minHeight": 780
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
